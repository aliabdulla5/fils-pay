node_modules/
dist/
*.tsbuildinfo
.env
.env.local
npm-debug.log*
.DS_Store
# Per-person Claude Code state stays local; the team's shared settings and
# custom commands are committed.
.claude/*
!.claude/settings.json
!.claude/commands/

# Real env files never go in git (ops/.env.docker held a live signing
# secret). `.env` does not match `.env.docker` — gitignore has no prefixes.
.env.*
!.env.*.example
!.env.development

# Operational output of one-off scripts (scripts/reconcile_march.ts appends
# its run log here). Kept on the box that ran it, never committed.
scripts/out/
