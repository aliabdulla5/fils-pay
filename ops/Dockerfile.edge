# Edge image: builds apps/web and apps/admin and serves them with nginx,
# which also proxies /v1 to the api and sheds excess load (ops/nginx.conf).
FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
# The browser bundles need no native modules (argon2 is api-only).
RUN npm ci --no-audit --no-fund --ignore-scripts

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
COPY apps/admin apps/admin

# Empty API base URLs: the bundles call /v1 on their own origin (this edge).
# WEB_BASE_URL is where the admin console links to the merchant dashboard.
ARG WEB_BASE_URL=http://localhost
RUN cd apps/web && VITE_API_BASE_URL= npx vite build \
 && cd ../admin && VITE_ADMIN_API_BASE_URL= VITE_WEB_BASE_URL=$WEB_BASE_URL npx vite build

FROM nginx:1.27-alpine
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY ops/api-proxy.inc /etc/nginx/conf.d/api-proxy.inc
COPY --from=build /app/apps/web/dist /srv/web
COPY --from=build /app/apps/admin/dist /srv/admin
EXPOSE 80 8080
