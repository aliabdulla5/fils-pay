# Template for the compose environment. Copy it to ops/.env (gitignored) —
# docker compose reads that file for the ${VAR} substitutions in
# docker-compose.yml; it does not read ops/.env.docker. Fill in values from
# the secret store and never commit the filled-in file.
#
# NODE_ENV defaults to production in compose (fail closed). Set it to
# development only on a laptop: it exposes the OTP code in login responses.
#
# The previous ops/.env.docker was tracked in git with the acquirer callback
# signing secret in it; that value is in history and must be rotated with
# the acquirer, not just deleted.
NODE_ENV=development
ACQUIRER_CALLBACK_SIGNING_SECRET=
SETTLEMENT_INTERNAL_TOKEN=
WEBHOOK_SECRET_ENCRYPTION_KEY=

# OTP email delivery (SMTP). Get these from your email provider. Port 465
# normally uses OTP_SMTP_SECURE=true; port 587 normally uses false (STARTTLS).
OTP_SMTP_HOST=
OTP_SMTP_PORT=587
OTP_SMTP_SECURE=false
OTP_SMTP_USER=
OTP_SMTP_PASSWORD=
OTP_FROM_EMAIL=
OTP_FROM_NAME=FilsPay
