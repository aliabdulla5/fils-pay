{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bash(go test ./...)",
      "Bash(go vet ./...)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(scripts/dev/verify.sh)"
