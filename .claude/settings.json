    "deny": [
      "Edit(packages/money/**)",
      "Write(packages/money/**)",
      "Edit(apps/settlement/internal/money/**)",
      "Write(apps/settlement/internal/money/**)",
      "Edit(**/*.test.ts)",
      "Write(**/*.test.ts)",
